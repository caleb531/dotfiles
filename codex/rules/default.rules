# Allow the standard pnpm formatter
prefix_rule(pattern=["pnpm", "format"], decision="allow")

# Allow the standard pnpm linter
prefix_rule(pattern=["pnpm", "lint"], decision="allow")

# Allow the standard pnpm test runner
prefix_rule(pattern=["pnpm", "test"], decision="allow")

# Allow installation of the ServiceNow SDK setup skill
prefix_rule(pattern=["python3", "/Users/caleb/.codex/skills/.system/skill-installer/scripts/install-skill-from-github.py", "--url", "https://github.com/ServiceNow/sdk/tree/master/skills/now-sdk-setup"], decision="allow")

# Allow installation of the ServiceNow SDK explanation skill
prefix_rule(pattern=["python3", "/Users/caleb/.codex/skills/.system/skill-installer/scripts/install-skill-from-github.py", "--url", "https://github.com/ServiceNow/sdk/tree/master/skills/now-sdk-explain"], decision="allow")

# Allow pnpm to use the shared package store
prefix_rule(pattern=["pnpm", "--store-dir", "/Users/caleb/Library/pnpm/store/v10"], decision="allow")

# Allow the ServiceNow SDK package runner
prefix_rule(pattern=["npx", "@servicenow/sdk"], decision="allow")

# Allow the now-sdk command through pnpm
prefix_rule(pattern=["pnpm", "exec", "now-sdk"], decision="allow")

# Allow the repository ServiceNow table query helper
prefix_rule(pattern=["node", "tools/servicenow/query-table.mjs"], decision="allow")

# Allow the repository EC Nova portal creation helper
prefix_rule(pattern=["node", "tools/servicenow/create-ec-nova-portal.mjs"], decision="allow")

# Allow the repository ServiceNow page fetch helper
prefix_rule(pattern=["node", "tools/servicenow/fetch-page.mjs"], decision="allow")

# Allow the awsm-sn command through pnpm
prefix_rule(pattern=["pnpm", "exec", "awsm-sn"], decision="allow")

# Allow package metadata lookup through pnpm
prefix_rule(pattern=["pnpm", "view"], decision="allow")

# Allow explicit AppleScript snippets
prefix_rule(pattern=["osascript", "-e"], decision="allow")

# Allow SuiteCloud object imports
prefix_rule(pattern=["suitecloud", "object:import"], decision="allow")
