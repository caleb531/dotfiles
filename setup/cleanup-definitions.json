[
  {
    "description": "Delete unused Docker images",
    "cleanup_command": "docker image prune -a",
    "filesize_command": "docker system df --format '{{if eq .Type \"Images\"}}{{.Reclaimable}}{{end}}' | grep -Eo '[0-9]+([.][0-9]+)?[[:alpha:]]+'"
  },
  {
    "description": "Delete Docker build cache",
    "cleanup_command": "docker builder prune",
    "filesize_command": "docker system df --format '{{if eq .Type \"Build Cache\"}}{{.Reclaimable}}{{end}}' | grep -Eo '[0-9]+([.][0-9]+)?[[:alpha:]]+'"
  },
  {
    "description": "Delete Homebrew cache",
    "cleanup_command": "brew cleanup --prune=all",
    "filesize_command": "brew cleanup --prune=all --dry-run 2>/dev/null | grep -Eo '[0-9]+([.][0-9]+)?[[:alpha:]]+' | tail -n 1"
  },
  {
    "description": "Delete user cache store",
    "path": "~/Library/Caches/*"
  },
  {
    "description": "Delete Messages caches",
    "path": "~/Library/Messages/Caches/*",
    "app": "Messages"
  },
  {
    "description": "Delete temporary Messages items",
    "path": "~/Library/Containers/com.apple.MobileSMS/Data/tmp/TemporaryItems/*"
  },
  {
    "description": "Delete Chrome updater CRX cache",
    "path": "~/Library/Application Support/Google/GoogleUpdater/crx_cache/*"
  },
  {
    "description": "Delete application logs",
    "path": "~/Library/Logs/*"
  },
  {
    "description": "Delete cached Brave browser data",
    "path": "~/Library/Application Support/BraveSoftware/Brave-Browser/*/Service Worker/*",
    "app": "Brave Browser"
  },
  {
    "description": "Delete uv cache",
    "cleanup_command": "uv cache clean",
    "filesize_command": "uv cache size --human --preview-features cache-size"
  },
  {
    "description": "Delete Puppeteer cache",
    "path": "~/.cache/puppeteer"
  },
  {
    "description": "Delete Slack cache",
    "path": "~/Library/Application Support/Slack/Cache/*"
  },
  {
    "description": "Delete Codex CLI logs",
    "path": "~/.codex/logs_2.sqlite*"
  }
]
